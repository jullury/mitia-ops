# copy to server env or export directly
MITIAOPS_KEY=change-me-to-a-long-random-string
# alternatively, read the master key from a file:
# MITIAOPS_KEY_FILE=/etc/mitia-ops/key
# MITIAOPS_ADDR=:8080
# MITIAOPS_DATA=data
# MITIAOPS_DEPLOY=deployments
# MITIAOPS_BACKUPS=data/backups
# MITIAOPS_BACKUP_SCHEDULE=off
# Password protecting dashboard access (HTTP Basic Auth). When unset, the
# dashboard is unauthenticated. Prefer MITIAOPS_PASSWORD_FILE for secrets.
# MITIAOPS_PASSWORD=
# MITIAOPS_PASSWORD_FILE=/etc/mitia-ops/dashboard-password
